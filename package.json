    "@astrojs/ts-content-mapper": "^0.2.0",
    "@types/node": "^26.6.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "7.1.0-beta"
  },
  "engines": {
    "node": "^24.21.0",
    "pnpm": "^12.5.1"
