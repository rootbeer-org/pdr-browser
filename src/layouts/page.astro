---
import "#/styles.css";
import { docs, recipesUrl } from "#/site.ts";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Packages you can install with Rootbeer" } = Astro.props;

const guides = [
  [docs.runTool, "Run a tool"],
  [docs.keepInstalled, "Install for your user"],
  [docs.declareInConfig, "Manage with Lua"],
  [docs.packageLocks, "Updates and offline use"],
  [docs.packageSources, "Other package sources"],
  [docs.packaging, "Contribute a package"],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:bg-bg focus:px-2 focus:py-1"
    >
      Skip to content
    </a>
    <header class="border-b border-border">
      <div class="mx-auto flex h-12 max-w-5xl items-center gap-4 px-4">
        <a class="font-bold" href="/">
          Rootbeer Packages
        </a>
        <nav class="ml-auto flex gap-4" aria-label="Site">
          <a class="link" href={docs.home}>
            Docs
          </a>
          <a class="link" href={recipesUrl}>
            Recipes
          </a>
        </nav>
      </div>
    </header>

    <main id="content" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
      <slot />
    </main>

    <footer class="border-t border-border text-muted">
      <div class="mx-auto flex max-w-5xl flex-wrap gap-x-6 gap-y-4 px-4 py-6">
        <nav aria-label="Guides">
          <h2 class="mb-2 heading">Guides</h2>
          <ul class="grid gap-x-6 gap-y-1 sm:grid-cols-2">
            {guides.map(([href, label]) => (
              <li>
                <a class="link" href={href}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="sm:ml-auto" aria-label="Data">
          <h2 class="mb-2 heading">Data</h2>
          <a class="link" href="/catalog.json">
            catalog.json
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
