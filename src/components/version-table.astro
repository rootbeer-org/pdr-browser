---
import { platforms, type IndexEntry } from "#/catalog/types.ts";
import { availableVersions } from "#/catalog/versions.ts";
import { packageHref } from "#/site.ts";

interface Props {
  pkg: IndexEntry;
}

const { pkg } = Astro.props;
const versions = availableVersions(pkg);
---

<section class="mt-8" aria-label={`${pkg.name} versions`}>
  <h2 class="heading">Versions ({versions.length})</h2>
  <div class="mt-2 max-h-80 overflow-auto border border-border">
    <table class="w-full border-collapse">
      <thead class="sticky top-0 bg-surface">
        <tr class="border-b border-border">
          <th class="px-2 py-1 text-left heading">Version</th>
          {platforms.map((platform) => (
            <th class="px-2 py-1 text-left heading">{platform.short}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {versions.map((version) => (
          <tr class="border-b border-border last:border-b-0 hover:bg-surface">
            <th scope="row" class="px-2 py-1 text-left font-normal whitespace-nowrap">
              <code>{version}</code>
            </th>
            {platforms.map((platform) => (
              <td class="px-2 py-1 whitespace-nowrap">
                {pkg.versions[version][platform.id] ? (
                  <a
                    class="link"
                    href={packageHref(pkg.name, version, platform.id)}
                    aria-label={`Use ${pkg.name} ${version} on ${platform.short}`}
                  >
                    {pkg.default[platform.id] === version ? "default" : "use"}
                  </a>
                ) : (
                  <span class="text-muted">-</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
