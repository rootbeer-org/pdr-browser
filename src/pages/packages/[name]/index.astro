---
import type { GetStaticPaths } from "astro";
import PackageDetails from "#/components/package-details.tsx";
import VersionTable from "#/components/version-table.astro";
import Page from "#/layouts/page.astro";
import { getCollection, getEntry } from "astro:content";

export const getStaticPaths = (async () => {
  const packages = (await getCollection("packages")).map(({ data }) => data);
  const usedBy = new Map<string, Set<string>>();
  for (const pkg of packages) {
    for (const [system, version] of Object.entries(pkg.default)) {
      for (const dependency of pkg.versions[version][system].runtime_dependencies) {
        usedBy.set(dependency, (usedBy.get(dependency) ?? new Set()).add(pkg.name));
      }
    }
  }

  return packages.map((pkg) => ({
    params: { name: pkg.name },
    props: { pkg, usedBy: [...(usedBy.get(pkg.name) ?? [])].sort() },
  }));
}) satisfies GetStaticPaths;

const { pkg, usedBy } = Astro.props;
const { targets_version, expires } = (await getEntry("catalog", "current"))!.data;
---

<Page title={`${pkg.name} · Rootbeer Packages`} description={pkg.description}>
  <PackageDetails
    client:load
    pkg={pkg}
    usedBy={usedBy}
    targets_version={targets_version}
    expires={expires}
  >
    <VersionTable pkg={pkg} />
  </PackageDetails>
</Page>
